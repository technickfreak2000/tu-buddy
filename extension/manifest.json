{
  "manifest_version": 3,
  "name": "TU Berlin Auto Login",
  "version": "1.3.2",
  "description": "Automatic TU Berlin login for ISIS, Moses, TUport and TUB-Guest Wi-Fi, with local password and TOTP autofill.",
  "permissions": ["storage", "captivePortal", "alarms", "nativeMessaging", "webNavigation"],
  "host_permissions": [
    "https://isis.tu-berlin.de/*",
    "https://moseskonto.tu-berlin.de/*",
    "https://tuport.sap.tu-berlin.de/*",
    "https://shibboleth.tubit.tu-berlin.de/*",
    "https://radius-01.tu-berlin.de/*"
  ],
  "background": {"scripts": ["background.js"], "type": "module"},
  "content_scripts": [{
    "matches": [
      "https://isis.tu-berlin.de/*",
      "https://moseskonto.tu-berlin.de/*",
      "https://tuport.sap.tu-berlin.de/*",
      "https://shibboleth.tubit.tu-berlin.de/idp/*",
      "https://radius-01.tu-berlin.de/portal/*"
    ],
    "js": ["adapters.js", "content.js"],
    "run_at": "document_idle"
  }],
  "options_ui": {"page": "options/options.html", "open_in_tab": true},
  "action": {
    "default_title": "TU Berlin Auto Login",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/tu.svg"
  },
  "icons": {"48": "icons/tu.svg", "96": "icons/tu.svg"},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tu-auto-login@local.nick",
      "strict_min_version": "142.0",
      "data_collection_permissions": {"required": ["authenticationInfo"]}
    }
  }
}
